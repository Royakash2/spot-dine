# Server Environment Variables
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI or Atlas Cluster)
MONGODB_URI=mongodb://localhost:27017/spot-dine

# JSON Web Token Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# CORS Allowed Origins (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary Storage Configuration for Restaurant Cover Images
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name
